<ui:FluentWindow
    x:Class="LiveCaptionsTranslator.SettingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="API Setting"
    Width="950"
    Height="500"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    Topmost="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Height="27"
            ShowMaximize="False">
            <ui:TitleBar.Header>
                <ui:TextBlock Padding="15,0,0,0" VerticalAlignment="Center">API Setting</ui:TextBlock>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Width="200">
                        <ui:Button
                            x:Name="PromptButton"
                            Margin="10,10,5,0"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="NavigationButton_Click"
                            Tag="Prompt">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,10,0" Symbol="DocumentCatchUp16" />
                                <ui:TextBlock VerticalAlignment="Center" Text="Prompt" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button
                            x:Name="SpeechRecognitionButton"
                            Margin="10,5,5,0"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="NavigationButton_Click"
                            Tag="SpeechRecognition">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,10,0" Symbol="Mic16" />
                                <ui:TextBlock VerticalAlignment="Center" Text="Speech Recognition" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button
                            x:Name="UsageButton"
                            Margin="10,5,5,0"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="NavigationButton_Click"
                            Tag="Usage">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,10,0" Symbol="Money16" />
                                <ui:TextBlock VerticalAlignment="Center" Text="Credit Usage" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button
                            x:Name="OllamaButton"
                            Margin="10,5,5,0"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="NavigationButton_Click"
                            Tag="Ollama">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock VerticalAlignment="Center" Text="Ollama" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button
                            x:Name="LMStudioButton"
                            Margin="10,5,5,0"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="NavigationButton_Click"
                            Tag="LMStudio">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock VerticalAlignment="Center" Text="LMStudio" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button
                            x:Name="OpenAIButton"
                            Margin="10,5,5,0"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="NavigationButton_Click"
                            Tag="OpenAI">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock VerticalAlignment="Center" Text="OpenAI" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button
                            x:Name="GPTButton"
                            Margin="10,5,5,0"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="NavigationButton_Click"
                            Tag="GPT">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock VerticalAlignment="Center" Text="GPT (API Key)" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button
                            x:Name="ChatGPTButton"
                            Margin="10,5,5,0"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="NavigationButton_Click"
                            Tag="ChatGPT">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock VerticalAlignment="Center" Text="ChatGPT" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button
                            x:Name="OpenRouterButton"
                            Margin="10,5,5,0"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="NavigationButton_Click"
                            Tag="OpenRouter">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock VerticalAlignment="Center" Text="OpenRouter" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button
                            x:Name="DeepLButton"
                            Margin="10,5,5,0"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="NavigationButton_Click"
                            Tag="DeepL">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock VerticalAlignment="Center" Text="DeepL" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button
                            x:Name="YoudaoButton"
                            Margin="10,5,5,0"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="NavigationButton_Click"
                            Tag="Youdao">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock VerticalAlignment="Center" Text="Youdao" />
                            </StackPanel>
                        </ui:Button>


                        <ui:Button
                            x:Name="MTranServerButton"
                            Margin="10,5,5,0"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="NavigationButton_Click"
                            Tag="MTranServer">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock VerticalAlignment="Center" Text="MTranServer" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button
                            x:Name="BaiduButton"
                            Margin="10,5,5,0"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="NavigationButton_Click"
                            Tag="Baidu">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock VerticalAlignment="Center" Text="Baidu" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button
                            x:Name="LibreTranslateButton"
                            Margin="10,5,5,0"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="NavigationButton_Click"
                            Tag="LibreTranslate">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock VerticalAlignment="Center" Text="LibreTranslate" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border
                Grid.Column="1"
                Margin="4"
                Background="{ui:ThemeResource SystemFillColorNeutralBackgroundBrush}"
                CornerRadius="8">
                <ScrollViewer x:Name="ContentScrollViewer" VerticalScrollBarVisibility="Auto">

                    <StackPanel x:Name="ContentPanel" Margin="30">
                        <ui:TextBlock
                            Margin="0,0,0,10"
                            FontSize="28"
                            FontWeight="Heavy"
                            Text="API Setting" />

                        <StackPanel x:Name="AllSettings" Margin="5">
                            <StackPanel x:Name="PromptSection" Margin="20">
                                <ui:TextBlock
                                    Margin="10"
                                    FontSize="20"
                                    FontWeight="Medium"
                                    Text="Prompt" />
                                <ui:Card Padding="15">
                                    <StackPanel Margin="15,0,15,0" Orientation="Vertical">
                                        <ui:TextBlock Margin="2.5,0,0,5" TextWrapping="Wrap">
                                            <Run FontWeight="Bold" Text="Note 1:" />
                                            <Run Text="The {0} in the prompt indicates the target language, so make sure your prompt includes {0}." />
                                            <Run FontWeight="Bold" Text="&#x0A;Note 2:" />
                                            <Run Text="The source text is enclosed with 🔤." />
                                        </ui:TextBlock>
                                        <ui:TextBox
                                            x:Name="PromptTextBox"
                                            AcceptsReturn="True"
                                            ClearButtonEnabled="False"
                                            Text="{Binding Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>

                            <StackPanel x:Name="SpeechRecognitionSection" Margin="20">
                                <ui:TextBlock
                                    Margin="10"
                                    FontSize="20"
                                    FontWeight="Medium"
                                    Text="Speech Recognition" />
                                <ui:Card Padding="15">
                                    <StackPanel Margin="15,0,15,0">
                                        <ui:TextBlock
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="Where the source captions come from. OpenAI listens to your PC audio. gpt-transcribe writes each line after it ends (0.0045 USD per minute, cheapest). gpt-live-transcribe shows text while someone is still talking (0.017 USD per minute). Long silence is not sent."
                                            TextWrapping="Wrap" />
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                                <ui:TextBlock Margin="2.5,0,0,5" Text="Source" />
                                                <ComboBox
                                                    x:Name="TranscriptionSourceBox"
                                                    Width="150"
                                                    Height="30"
                                                    Padding="10,4,10,7"
                                                    FontSize="13.3"
                                                    SelectedItem="{Binding Transcription.Source, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    SelectionChanged="TranscriptionSourceBox_SelectionChanged" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="15,0,0,0"
                                                Orientation="Vertical">
                                                <ui:TextBlock Margin="2.5,0,0,5" Text="Language" />
                                                <ui:TextBox
                                                    Width="80"
                                                    Height="30"
                                                    Padding="10,4,10,7"
                                                    FontSize="13.3"
                                                    PlaceholderText="ja"
                                                    Text="{Binding Transcription.Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                Margin="15,0,0,0"
                                                Orientation="Vertical">
                                                <ui:TextBlock Margin="2.5,0,0,5" Text="OpenAI API Key (empty: use the GPT engine key)" />
                                                <ui:PasswordBox
                                                    Width="260"
                                                    Height="30"
                                                    Padding="10,4,10,7"
                                                    FontSize="13.3"
                                                    Password="{Binding Transcription.ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                                <ui:TextBlock Margin="2.5,0,0,5" Text="Model" />
                                                <ComboBox
                                                    x:Name="TranscriptionModelBox"
                                                    Width="190"
                                                    Height="30"
                                                    Padding="10,4,10,7"
                                                    FontSize="13.3"
                                                    SelectedItem="{Binding Transcription.Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="15,0,0,0"
                                                Orientation="Vertical">
                                                <ui:TextBlock Margin="2.5,0,0,5" Text="Delay (gpt-live-transcribe only)" />
                                                <ComboBox
                                                    x:Name="TranscriptionDelayBox"
                                                    Width="130"
                                                    Height="30"
                                                    Padding="10,4,10,7"
                                                    FontSize="13.3"
                                                    SelectedItem="{Binding Transcription.Delay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <ui:TextBlock Margin="2.5,12,0,5" Text="Keywords (names and terms, one per line. Add =번역 to fix the translation, e.g. 宝鐘マリン=호쇼 마린)" />
                                        <ui:TextBox
                                            Height="70"
                                            AcceptsReturn="True"
                                            ClearButtonEnabled="False"
                                            FontSize="13.3"
                                            PlaceholderText="e.g. character names, place names"
                                            Text="{Binding Transcription.Keywords, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto" />
                                        <ui:TextBlock Margin="2.5,10,0,5" Text="Context (what you are listening to)" />
                                        <ui:TextBox
                                            ClearButtonEnabled="False"
                                            FontSize="13.3"
                                            PlaceholderText="e.g. A Japanese anime episode about a high school band."
                                            Text="{Binding Transcription.Prompt, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                            TextWrapping="Wrap" />

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel
                                                Grid.Column="0"
                                                Margin="0,0,0,0"
                                                Orientation="Vertical">
                                                <ui:TextBlock Margin="2.5,0,0,5" Text="Voice Threshold (0-1)" />
                                                <ui:NumberBox
                                                    Width="130"
                                                    Height="30"
                                                    Padding="10,4,10,7"
                                                    ClearButtonEnabled="False"
                                                    FontSize="13.3"
                                                    Maximum="1"
                                                    Minimum="0"
                                                    SmallChange="0.05"
                                                    Value="{Binding Transcription.VadThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="15,0,0,0"
                                                Orientation="Vertical">
                                                <ui:TextBlock Margin="2.5,0,0,5" Text="Pause to End Line (ms)" />
                                                <ui:NumberBox
                                                    Width="130"
                                                    Height="30"
                                                    Padding="10,4,10,7"
                                                    ClearButtonEnabled="False"
                                                    FontSize="13.3"
                                                    Maximum="3000"
                                                    Minimum="200"
                                                    SmallChange="100"
                                                    Value="{Binding Transcription.SilenceDurationMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                Margin="15,0,0,0"
                                                Orientation="Vertical">
                                                <ui:TextBlock Margin="2.5,0,0,5" Text="Max Line Length (s)" />
                                                <ui:NumberBox
                                                    Width="130"
                                                    Height="30"
                                                    Padding="10,4,10,7"
                                                    ClearButtonEnabled="False"
                                                    FontSize="13.3"
                                                    Maximum="60"
                                                    Minimum="0"
                                                    SmallChange="1"
                                                    Value="{Binding Transcription.MaxTurnSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                        <ui:TextBlock
                                            Margin="2.5,8,0,0"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="Model, language, keywords, context and voice settings apply when listening restarts (toggle the microphone button on the main window)."
                                            TextWrapping="Wrap" />
                                        <ui:TextBlock
                                            x:Name="TranscriptionStatusText"
                                            Margin="2.5,8,0,0"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>

                            <StackPanel x:Name="UsageSection" Margin="20">
                                <ui:TextBlock
                                    Margin="10"
                                    FontSize="20"
                                    FontWeight="Medium"
                                    Text="Credit Usage" />
                                <ui:Card Padding="15">
                                    <StackPanel Margin="15,0,15,0">
                                        <ui:TextBlock
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="Calculated from the usage OpenAI reports for every request (translation tokens, transcribed audio duration) times the published prices. Covers the GPT engine and OpenAI speech recognition."
                                            TextWrapping="Wrap" />
                                        <ui:TextBlock
                                            x:Name="UsageSummaryText"
                                            Margin="0,12,0,0"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap" />
                                        <ui:TextBlock
                                            x:Name="UsageDetailText"
                                            Margin="0,6,0,0"
                                            TextWrapping="Wrap" />
                                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                            <StackPanel Orientation="Vertical">
                                                <ui:TextBlock Margin="2.5,0,0,5" Text="Starting Balance (USD)" />
                                                <ui:NumberBox
                                                    x:Name="StartingBalanceBox"
                                                    Width="130"
                                                    Height="30"
                                                    Padding="10,4,10,7"
                                                    ClearButtonEnabled="False"
                                                    FontSize="13.3"
                                                    Maximum="10000"
                                                    Minimum="0"
                                                    SmallChange="1" />
                                            </StackPanel>
                                            <ui:Button
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Bottom"
                                                Click="SetBalanceButton_Click"
                                                Content="Set" />
                                            <ui:Button
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Bottom"
                                                Click="ResetUsageButton_Click"
                                                Content="Reset Counter" />
                                        </StackPanel>
                                        <CheckBox
                                            Margin="0,14,0,0"
                                            Content="When the API credit runs out, keep going: translate with the ChatGPT plan (sign in under ChatGPT), then Google; listen with Windows LiveCaptions."
                                            IsChecked="{Binding CreditFallback, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <CheckBox.ContentTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </CheckBox.ContentTemplate>
                                        </CheckBox>
                                        <ui:TextBlock
                                            x:Name="CreditRouteText"
                                            Margin="0,6,0,0"
                                            TextWrapping="Wrap" />
                                        <ui:TextBlock Margin="0,12,0,0" TextWrapping="Wrap">
                                            <Run Text="Official numbers (updated with a delay): " />
                                            <Hyperlink NavigateUri="https://platform.openai.com/usage" RequestNavigate="ChatGPTManageUsage_RequestNavigate">platform.openai.com/usage</Hyperlink>
                                        </ui:TextBlock>
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>

                            <StackPanel x:Name="OllamaSection" Margin="20">
                                <ui:TextBlock
                                    Margin="10"
                                    FontSize="20"
                                    FontWeight="Medium"
                                    Text="Ollama" />
                                <ui:Card Padding="15">
                                    <StackPanel>
                                        <Grid Margin="15,0,15,10">
                                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                                <ui:TextBlock
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Bold"
                                                    Text="Current Config: " />
                                                <ui:Button
                                                    Margin="0,0,10,0"
                                                    Padding="8,4,8,4"
                                                    Click="PriorButton_Click"
                                                    Icon="{ui:SymbolIcon chevronLeft12}"
                                                    Tag="Ollama" />
                                                <ui:TextBlock
                                                    x:Name="OllamaIndex"
                                                    VerticalAlignment="Center"
                                                    Text="1/1" />
                                                <ui:Button
                                                    Margin="10,0,0,0"
                                                    Padding="8,4,8,4"
                                                    Click="NextButton_Click"
                                                    Icon="{ui:SymbolIcon chevronRight12}"
                                                    Tag="Ollama" />
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                <ui:Button
                                                    Margin="0,0,10,0"
                                                    Click="NewButton_Click"
                                                    Content="New"
                                                    Tag="Ollama" />
                                                <ui:Button
                                                    Margin="0,0,-10,0"
                                                    Click="DeleteButton_Click"
                                                    Content="Delete"
                                                    Tag="Ollama" />
                                                <ui:Flyout x:Name="OllamaDeleteFlyout">
                                                    <TextBlock
                                                        Width="120"
                                                        Text="You must keep at least one config."
                                                        TextWrapping="Wrap" />
                                                </ui:Flyout>
                                            </StackPanel>
                                        </Grid>
                                        <Separator Margin="0,0,0,10" />
                                        <Grid x:Name="OllamaGrid">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="15,0,0,0"
                                                Orientation="Vertical">
                                                <ui:TextBlock Margin="2.5,0,0,5" Text="Model Name" />
                                                <ui:TextBox
                                                    Width="130"
                                                    Height="30"
                                                    Padding="10,4,10,7"
                                                    FontSize="13.3"
                                                    Text="{Binding [Ollama].ModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="15,10,0,0"
                                                Orientation="Vertical">
                                                <ui:TextBlock Margin="2.5,0,0,5" Text="Temperature" />
                                                <ui:NumberBox
                                                    Width="130"
                                                    Height="30"
                                                    Padding="10,4,10,7"
                                                    ClearButtonEnabled="False"
                                                    FontSize="13.3"
                                                    LargeChange="1"
                                                    Maximum="2"
                                                    Minimum="0"
                                                    SmallChange="0.1"
                                                    Value="{Binding [Ollama].Temperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="15,0,0,0"
                                                Orientation="Vertical">
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                    <ui:TextBlock Margin="2.5,0,0,5" Text="API Url" />
                                                    <ui:Flyout x:Name="OllamaAPIUrlInfoFlyout">
                                                        <ui:TextBlock Width="170" TextWrapping="Wrap">
                                                            <Run Text="No need to explicitly add" />
                                                            <Run FontWeight="Bold" Text="`api/chat`" />
                                                            <Run Text="suffix." />
                                                        </ui:TextBlock>
                                                    </ui:Flyout>
                                                    <Button
                                                        Width="15"
                                                        Height="15"
                                                        Margin="-5,-3,0,0"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        MouseEnter="OllamaAPIUrlInfo_MouseEnter"
                                                        MouseLeave="OllamaAPIUrlInfo_MouseLeave">
                                                        <ui:SymbolIcon Symbol="Info16" />
                                                    </Button>
                                                </StackPanel>

                                                <ui:TextBox
                                                    Width="200"
                                                    Height="30"
                                                    Padding="10,4,10,7"
                                                    FontSize="13.3"
                                                    Text="{Binding [Ollama].ApiUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>

                            <StackPanel x:Name="LMStudioSection" Margin="20">
                                <ui:TextBlock
                                    Margin="10"
                                    FontSize="20"
                                    FontWeight="Medium"
                                    Text="LMStudio" />
                                <ui:Card Padding="15">
                                    <StackPanel>
                                        <Grid Margin="15,0,15,10">
                                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                                <ui:TextBlock
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Bold"
                                                    Text="Current Config: " />
                                                <ui:Button
                                                    Margin="0,0,10,0"
                                                    Padding="8,4,8,4"
                                                    Click="PriorButton_Click"
